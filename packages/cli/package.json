{
  "name": "supawatch",
  "version": "0.5.0",
  "description": "Validator schemas and types generated from your live Postgres, kept in sync by the database itself.",
  "keywords": [
    "supabase",
    "postgres",
    "postgresql",
    "codegen",
    "schema",
    "typescript",
    "zod",
    "valibot",
    "arktype",
    "typebox",
    "cli",
    "watch",
    "introspection"
  ],
  "license": "MIT",
  "author": "Omar Dulaimi",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/omar-dulaimi/supawatch.git",
    "directory": "packages/cli"
  },
  "type": "module",
  "bin": {
    "supawatch": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@supawatch/core": "workspace:*",
    "@supawatch/target-ai-tools": "workspace:*",
    "@supawatch/target-arktype": "workspace:*",
    "@supawatch/target-dictionary": "workspace:*",
    "@supawatch/target-effect": "workspace:*",
    "@supawatch/target-erd": "workspace:*",
    "@supawatch/target-factories": "workspace:*",
    "@supawatch/target-fast-check": "workspace:*",
    "@supawatch/target-forms": "workspace:*",
    "@supawatch/target-graphql": "workspace:*",
    "@supawatch/target-json-schema": "workspace:*",
    "@supawatch/target-mcp": "workspace:*",
    "@supawatch/target-orpc": "workspace:*",
    "@supawatch/target-pgmq": "workspace:*",
    "@supawatch/target-pgtap": "workspace:*",
    "@supawatch/target-realtime": "workspace:*",
    "@supawatch/target-rest": "workspace:*",
    "@supawatch/target-rls": "workspace:*",
    "@supawatch/target-schema-card": "workspace:*",
    "@supawatch/target-schema-lock": "workspace:*",
    "@supawatch/target-seed": "workspace:*",
    "@supawatch/target-service": "workspace:*",
    "@supawatch/target-supabase-types": "workspace:*",
    "@supawatch/target-trpc": "workspace:*",
    "@supawatch/target-typebox": "workspace:*",
    "@supawatch/target-valibot": "workspace:*",
    "@supawatch/target-zod": "workspace:*",
    "@supawatch/watch": "workspace:*",
    "jiti": "^2.4.0",
    "postgres": "^3.4.5",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "typescript": "^5.9.0"
  }
}
